''========================================
'' SEQUENCE DIAGRAM - USER REGISTRATION
''========================================
@startuml SequenceDiagram1
title Sequence Diagram - User Registration Flow

actor User
participant "Express App" as App
participant "Auth Controller" as AuthCtrl
participant "User Repository" as UserRepo
participant "Auth Service" as AuthSvc
participant "Database" as DB
participant "Email Service" as Email

User -> App: POST /api/auth/register
App -> AuthCtrl: register(req, res)
AuthCtrl -> UserRepo: findByEmail(email)
UserRepo -> DB: SELECT * FROM users WHERE email
DB --> UserRepo: User data or null
UserRepo --> AuthCtrl: Existing user or null

alt User Already Exists
    AuthCtrl --> App: 400 Email already exists
    App --> User: Error Response
else New User
    AuthCtrl -> AuthSvc: hashPassword(password)
    AuthSvc --> AuthCtrl: Hashed password
    AuthCtrl -> UserRepo: createUser(userData)
    UserRepo -> DB: INSERT INTO users
    DB --> UserRepo: Created user
    UserRepo --> AuthCtrl: User object
    AuthCtrl -> AuthSvc: generateToken(user)
    AuthSvc --> AuthCtrl: JWT Token
    AuthCtrl -> Email: sendWelcomeEmail(email)
    Email --> AuthCtrl: Email sent
    AuthCtrl --> App: 201 User created with token
    App --> User: JWT Token + User Data
end

@enduml

''========================================
'' SEQUENCE DIAGRAM - POST CREATION
''========================================
@startuml SequenceDiagram2
title Sequence Diagram - Create Post in Room

actor User
participant "Express App" as App
participant "Auth Middleware" as AuthMW
participant "Post Controller" as PostCtrl
participant "Post Repository" as PostRepo
participant "Room Repository" as RoomRepo
participant "Database" as DB

User -> App: POST /api/posts (with JWT token)
App -> AuthMW: protect(req, res, next)
AuthMW -> AuthMW: verify JWT token
AuthMW --> App: next() - User authenticated

App -> PostCtrl: createPost(req, res)
PostCtrl -> RoomRepo: getRoomSuspension(roomId, userId)
RoomRepo -> DB: SELECT suspension WHERE room_id AND user_id
DB --> RoomRepo: Suspension data or null

alt User Suspended
    PostCtrl --> App: 403 User suspended
    App --> User: Error: Cannot post
else User Not Suspended
    PostCtrl -> PostRepo: createPost(postData)
    PostRepo -> DB: INSERT INTO posts
    DB --> PostRepo: Created post with ID
    PostRepo --> PostCtrl: Post object
    PostCtrl -> PostRepo: getPostById(postId, userId)
    PostRepo -> DB: SELECT posts with votes and comments
    DB --> PostRepo: Full post data
    PostRepo --> PostCtrl: Enriched post object
    PostCtrl --> App: 201 Post created
    App --> User: Post object with ID
end

@enduml

''========================================
'' SEQUENCE DIAGRAM - ROOM JOINING
''========================================
@startuml SequenceDiagram3
title Sequence Diagram - Join Room Flow

actor User
participant "Express App" as App
participant "Auth Middleware" as AuthMW
participant "Room Controller" as RoomCtrl
participant "Room Repository" as RoomRepo
participant "User Repository" as UserRepo
participant "Database" as DB

User -> App: POST /api/rooms/:roomId/join
App -> AuthMW: protect(req, res, next)
AuthMW -> AuthMW: verify JWT token
AuthMW --> App: User authenticated

App -> RoomCtrl: joinRoom(req, res)
RoomCtrl -> RoomRepo: findRoomById(roomId)
RoomRepo -> DB: SELECT * FROM rooms WHERE id
DB --> RoomRepo: Room data

alt Room Not Found
    RoomCtrl --> App: 404 Room not found
    App --> User: Error Response
else Room Exists
    RoomCtrl -> RoomRepo: addMember(roomId, userId, 'member')
    RoomRepo -> DB: INSERT INTO room_members
    DB --> RoomRepo: Member added
    RoomRepo --> RoomCtrl: Success
    RoomCtrl -> UserRepo: findById(userId)
    UserRepo -> DB: SELECT user data
    DB --> UserRepo: User object
    UserRepo --> RoomCtrl: User data
    RoomCtrl --> App: 200 Member added
    App --> User: Room membership confirmed
end

@enduml